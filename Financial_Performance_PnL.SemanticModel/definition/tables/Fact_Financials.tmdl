	partition Fact_Financials = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(SourceFolder & "\PnL_Dataset.xlsx"), null, true),
				    Fact_Financials_Sheet = Source{[Item="Fact_Financials",Kind="Sheet"]}[Data],
				    #"Promoted Headers" = Table.PromoteHeaders(Fact_Financials_Sheet, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"DateKey", Int64.Type}, {"BrandKey", Int64.Type}, {"RegionKey", Int64.Type}, {"ChannelKey", Int64.Type}, {"AccountName", type text}, {"BudgetAmount", Currency.Type}, {"ActualAmount", Currency.Type}, {"VersionType", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type", {"FactKey", "AccountCategory"}, MissingField.Ignore)
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

