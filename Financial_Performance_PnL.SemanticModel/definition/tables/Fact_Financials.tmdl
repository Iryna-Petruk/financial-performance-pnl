/// P&L fact table at month x brand x region x channel x account grain. One row per combination per version; Actual-version rows carry ActualAmount and Budget-version rows carry BudgetAmount, so the two never overlap. Synthetic data.
table Fact_Financials
	lineageTag: d625338b-a6e2-47d6-b2e6-daca7993a76f

	column DateKey
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: c77a4d52-f3e8-4908-9c4d-1c390b60e663
		summarizeBy: none
