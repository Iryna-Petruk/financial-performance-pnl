/// Daily calendar for 2024, marked as the model date table on [Date]. The fact is monthly, so only 12 of the 366 days carry data; the calendar is kept daily and contiguous because that is what date-table marking and time intelligence require.
table Dim_Date
	lineageTag: a38a89a6-7cd2-48d1-91eb-3a86efcb8dcf
	dataCategory: Time

	column DateKey
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 63d7a4f7-4939-4edf-a6a6-b6decacdac97
		summarizeBy: none
		sourceColumn: DateKey

		annotation SummarizationSetBy = Automatic

	/// Calendar date. Marked date column for the model.
	column Date
		dataType: dateTime
		isUnique
		isKey
		formatString: yyyy-mm-dd
		lineageTag: 1bd3a79d-0475-4015-a556-2c5875d7348e
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Calendar year of the date.
	column Year
		dataType: int64
		formatString: 0
		lineageTag: d1488498-e051-4031-a3c4-b18875aac1b9
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

	/// Calendar quarter label (Q1-Q4). Sorted by QuarterNum.
	column Quarter
		dataType: string
		lineageTag: 4a3fc8ec-1226-4214-96e1-e961edb0c9dd
		summarizeBy: none
		sourceColumn: Quarter
		sortByColumn: QuarterNum

		annotation SummarizationSetBy = Automatic

	column QuarterNum
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 250f7667-abd1-4c80-9dfa-baeaea9cb136
		summarizeBy: none
		sourceColumn: QuarterNum

		annotation SummarizationSetBy = Automatic

	column Month
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 10622198-fe87-498e-b4ef-7fa5f3511909
		summarizeBy: none
		sourceColumn: Month

		annotation SummarizationSetBy = Automatic

	/// Full month name. Sorted by Month, so charts run January to December.
	column MonthName
		dataType: string
		lineageTag: 54673385-cceb-452d-b288-0d2d8a6aed9f
		summarizeBy: none
		sourceColumn: MonthName
		sortByColumn: Month

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	partition Dim_Date = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(SourceFolder & "\PnL_Dataset.xlsx"), null, true),
				    Dim_Date_Sheet = Source{[Item="Dim_Date",Kind="Sheet"]}[Data],
				    #"Promoted Headers" = Table.PromoteHeaders(Dim_Date_Sheet, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"DateKey", Int64.Type}, {"Date", type date}, {"Year", Int64.Type}, {"Quarter", type text}, {"QuarterNum", Int64.Type}, {"Month", Int64.Type}, {"MonthName", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type", {"MonthShort", "Week", "Day", "Weekday", "IsWeekend", "YearMonth", "FiscalQuarter"}, MissingField.Ignore)
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

